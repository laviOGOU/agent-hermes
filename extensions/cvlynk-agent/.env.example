# ─────────────────────────────────────────────────────────────────────────────
#  Secrets du connecteur — copie ce fichier vers .env, jamais l'inverse.
#  Le jeton renvoyé par l'orchestrateur à l'enregistrement est un secret :
#  restreins les droits du fichier après l'avoir écrit.
#      icacls .env /inheritance:r /grant:r "%USERNAME%:(R)"
# ─────────────────────────────────────────────────────────────────────────────

# Clé d'enregistrement fournie par l'administrateur de l'orchestrateur
CVLYNK_API_KEY=[CLEF_D_ENREGISTREMENT]

# Adresse de base de l'orchestrateur
CVLYNK_BASE=https://[HOTE_ORCHESTRATEUR]

# Identifiant d'instance du connecteur : stable, il garantit qu'un même
# connecteur ne s'enregistre pas deux fois. À choisir une fois pour toutes.
CVLYNK_CLIENT_INSTANCE_ID=[identifiant-stable-de-ce-connecteur]

# Nom présenté à l'orchestrateur
CVLYNK_AGENT_NAME=[NOM_DU_CONNECTEUR]

# Valeurs renseignées AUTOMATIQUEMENT au premier enregistrement
CVLYNK_AGENT_ID=[attribue_par_l_orchestrateur]
CVLYNK_AGENT_ROLE=[attribue_par_l_orchestrateur]
CVLYNK_ACCESS_TOKEN=[jeton_renvoye_par_l_orchestrateur]

# ─────────────────────────────────────────────────────────────────────────────
#  Secrets — ne jamais versionner ce fichier (voir .gitignore)
#  Copie-le vers .env puis renseigne tes propres valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# Fournisseur de modèle (exemple : DeepSeek)
DEEPSEEK_API_KEY=[CLEF_API_FOURNISSEUR]

# Passerelle de messagerie (exemple : Telegram)
TELEGRAM_BOT_TOKEN=[JETON_DU_BOT]
TELEGRAM_ALLOWED_USERS=[TON_IDENTIFIANT_UTILISATEUR]

# Extensions réseau éventuelles
CVLYNK_API_KEY=[CLEF_D_ENREGISTREMENT_ORCHESTRATEUR]
CVLYNK_ACCESS_TOKEN=[JETON_RENVOYE_PAR_L_ORCHESTRATEUR]

# Rappel : ce fichier ne contient QUE des secrets.
# Les réglages de comportement vont dans config/config.exemple.yaml.
